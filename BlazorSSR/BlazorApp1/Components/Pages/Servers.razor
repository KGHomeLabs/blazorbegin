@page "/servers"
@using BlazorApp1.Services
@using BlazorApp1.Services.Models
@rendermode InteractiveServer
@inject NavigationManager NavigationManager

<h3>Servers</h3>
<br />
    <CityListComponent @rendermode="InteractiveServer" 
                       SelectedCityCallback="HandleCitySelection"/>
<br />
<p> Servers for @selectedCity</p>
<br />
   @* Displays a list of servers for a speciffic city or search filter (tbd) *@
   <ServerListComponent @rendermode="InteractiveServer" 
                        City="@selectedCity"/>
<br />
<br />
<a href="@($"servers/add")" class="btn btn-primary">Add Server</a>

@code {
    private string selectedCity { get; set; } = "Toronto";
   
    private void HandleCitySelection(string cityName)
    { 
        selectedCity = cityName;
    }
}
