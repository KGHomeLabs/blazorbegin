@page "/servers"
@using BlazorApp1.Services
@using BlazorApp1.Services.Models
@rendermode InteractiveServer
@inject NavigationManager NavigationManager

<h3>Servers</h3>
<br />
@* Displays a list of cities to filter servers by city *@
<CityListComponent @rendermode="InteractiveServer" 
                    SelectedCityCallback="HandleCitySelection"/>
<br />
@* Lets user search for a server Name *@
<ServerSearchBarComponent @rendermode="InteractiveServer" 
                            SearchFilterCallback="HandleSearchFilterChange"/>
<br />
<p> Servers for @selectedCity</p>
<br />
@* Displays a list of servers for a speciffic city or search filter (tbd) *@
<ServerListComponent @rendermode="InteractiveServer" 
                    City="@selectedCity"
                     SearchFilter="@searchFilter" />
<br />
<br />
<a href="@($"servers/add")" class="btn btn-primary">Add Server</a>

@code {
    private string selectedCity { get; set; } = "Toronto";

    private string searchFilter { get; set; } = String.Empty;

    private void HandleCitySelection(string cityName)
    { 
        selectedCity = cityName;
        searchFilter = String.Empty;
    }

    private void HandleSearchFilterChange(string searchFilter)
    {
        this.searchFilter = searchFilter;
    }
}
