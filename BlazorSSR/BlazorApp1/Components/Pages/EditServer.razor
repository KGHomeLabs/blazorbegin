@page "/servers/{id:int}"
@using BlazorApp1.Components.Controls.Generic
@using BlazorApp1.Services
@using BlazorApp1.Services.Models

@inject NavigationManager NavigationManager

<h3>Edit server bruh'</h3>
<br />
<br />
@if (server == null)
{
    <p><em>Loading server details...</em></p>
}
else
{
    <EditForm Model="server" FormName="formServer" OnValidSubmit="Submit">
        <DataAnnotationsValidator/>
        <ValidationSummary/>

        <InputNumber @bind-Value="server.Id" class="form-control" hidden />
        <FieldComponent Label="Name">
            <WhateverControl>
                <InputText @bind-Value="server.Name" class="form-control " />
            </WhateverControl>
            <MyValidationMessage>
                <ValidationMessage For="@(() => server.Name)" />
            </MyValidationMessage>
        </FieldComponent>

        <FieldComponent Label="City">
            <WhateverControl>
                <InputText @bind-Value="server.City" class="form-control " />
            </WhateverControl>
            <MyValidationMessage>
                <ValidationMessage For="@(() => server.City)" />
            </MyValidationMessage>
        </FieldComponent>

        <FieldComponent Label="Status">
            <WhateverControl>
                <InputCheckbox @bind-Value="server.IsOnline" class="form-check-input" />
            </WhateverControl>          
        </FieldComponent>        
        <br/>
        <button type="submit" class="btn btn-primary">Save</button>
        &nbsp;
        <a href="/servers" class="btn btn-primary">Back to Servers</a>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromForm(FormName = "formServer")]
    private Server? server { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        server ??= ServerRepository.GetServerById(Id);
    }

    private void Submit()
    {
        if (server != null)
        {
            ServerRepository.UpdateServer(server.Id,server);
            NavigationManager.NavigateTo("/servers");
        }
        
    }
}
