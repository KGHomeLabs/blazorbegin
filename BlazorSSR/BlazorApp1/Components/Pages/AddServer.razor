@page "/servers/add"

@using BlazorApp1.Services
@using BlazorApp1.Services.Models

@inject NavigationManager NavigationManager

<h3>AddServer</h3>
<br/>
@if(newServer == null || cities == null)
{
    <p><em>Getting data...</em></p>
}
else
{
    <EditForm Model="newServer" FormName="formNewServer" OnValidSubmit="validSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary/>

        <div class="row mb-3">
            <div class="col-2">
                <label class="col-form-label"> Location: </label>
            </div>
            <div class="col-4">
                    <InputSelect @bind-Value="@newServer.City" class="form-select">
                        @foreach (var option in cities)
                        {
                            <option value="@option">@option</option>
                        }
                    </InputSelect>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-2">
                <label class="col-form-label">Name</label>
            </div>
            <div class="col-4">
                <InputText @bind-Value="@newServer.Name" class="form-control" />
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-2">
                <label class="col-form-label">Status</label>
            </div>
            <div class="col-4">
                <InputCheckbox @bind-Value="@newServer.IsOnline" class="form-check-input" />
            </div>
        </div>    
        <button type="submit" class="btn btn-primary">Add</button>
    </EditForm>

}
@code {
    [SupplyParameterFromForm(FormName = "formNewServer")]
    private Server? newServer { get; set; } 

    private List<string>? cities { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        cities = Cities.GetCities();
        newServer ??= new Server();
    }

    public void validSubmit()
    {
        if (newServer != null)
        {
            ServerRepository.AddServer(newServer);
            NavigationManager.NavigateTo("/servers");
        }        
    }
}
