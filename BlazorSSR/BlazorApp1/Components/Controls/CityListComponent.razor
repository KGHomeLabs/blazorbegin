

@using BlazorApp1.Services

<div class="continainer-fluid text-center">
    <div class="row w-30">
        @foreach (var city in cities)
        {
            <div class="col">
                test
                <CityComponent 
                               City="@city" 
                               SelectedCity="@selectedCity" 
                               SelectedCityCallback="HandleCitySelection" />
            </div>
        }
    </div>
</div>

@code {

    private EventCallback<string> _selectedCityCallback;

    [Parameter]
    public EventCallback<string> SelectedCityCallback {
        get
        {
            return _selectedCityCallback;
        }  
        set
        {
            Console.WriteLine($"Calling: Instantiating");
            _selectedCityCallback = value;            
        }
    }

    public void ClearSelection()
    {
        this.selectedCity = "";
        StateHasChanged();
    }

    private List<string> cities = Cities.GetCities();

    private string selectedCity = "Toronto";

    private void HandleCitySelection(string cityName)
    {
        selectedCity = cityName;
        SelectedCityCallback.InvokeAsync(cityName);
    }

    override protected void OnParametersSet()
    {
        Console.WriteLine($"Calling: OnParametersSet");
    }
    override protected void OnInitialized()
    {
        Console.WriteLine($"Calling: OnInitialized");
    }
    override protected void OnAfterRender(bool firstRender)
    {
        Console.WriteLine($"Calling: OnAfterRender - firstRender: {firstRender}");
    }

    protected override bool ShouldRender()
    {
        Console.WriteLine($"Calling: ShouldRender");
        return base.ShouldRender();
    }
}
