@using BlazorApp1.Services.Models

@if(server == null)
{
    <p><em>Loading server details...</em></p>
}
else
{
    <div data-name="@server.Name"
         data-status="Server is @(server.IsOnline ? "online" : "offline")"
         style="color:@(server.IsOnline ? "blue" : "red")">
           
         @server.Name is located in @server.City @(server.IsOnline ? "online" : "offline")
          &nbsp;
        <button type="submit" class="btn btn-primary"
                @onclick="ChangeStatus">Turn On/Off</button>
    </div>
}

@code {
    private Server server = new Server { Name = "Goofy", City = "Basmati" };

    private void ChangeStatus()
    {
        server.IsOnline = !server.IsOnline;
    }
}
