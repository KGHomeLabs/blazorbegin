@using BlazorApp1.Services
@using BlazorApp1.Services.Models

@inject NavigationManager NavigationManager

@if(server == null)
{
    <p><em>Loading server details...</em></p>
}
else
{
    <li @key="server.Id">
        <div style="background-color:@GetBackgroundColor()">
            <b>@server.Name</b> in <i>@server.City</i> and is
                <span style="color:@(server.IsOnline ? "blue" : "red")">
                    @(server.IsOnline ? "online" : "offline")
                </span>
            &nbsp;
            @if (server.IsOnline)
            {
                <button type="button"
                        class="btn btn-outline-danger"
                        @onclick="ToggleStatus">
                    Turn Off
                </button>
            }
            else
            {
                <button type="button"
                        class="btn btn-outline-success"
                        @onclick="ToggleStatus">
                    Turn On
                </button>
            }
            &nbsp;
            @if (server.IsOnline)
            {
                Random rand = new Random();
                int people = rand.Next(0, 500);
                <text>@people</text>
            }
            else
            {
                <text>N/A</text>
            }
            &nbsp;
            <a href="@($"servers/{server.Id}")" class="btn btn-primary">edit @server.Id</a>
            &nbsp;
            <EditForm Model="server"
                        FormName="@($"formServer{server.Id}")"
                        OnValidSubmit="@(()=>{DeleteServer(server.Id);})">

                <button type="submit" class="btn btn-primary">Delete</button>
            </EditForm>
         </div>
    </li>
}

@code {
    [Parameter]
    public Server? Server { get; set; }

    [CascadingParameter(Name ="SelectedCity")]
    public string? SelectedCity { get; set; }

    private Server? server;

    protected override void OnParametersSet()
    {
        server = Server;
    }

    private void ToggleStatus()
    {
        if (server == null) return;
        server.IsOnline = !server.IsOnline;
    }

    private void DeleteServer(int id)
    {
        if (id <= 0) return;
        ServerRepository.DeleteServer(id);
        NavigationManager.NavigateTo("/servers", forceLoad: true);
    }

    private string GetBackgroundColor()
    {
       if (SelectedCity != null)
       {
            switch (SelectedCity.ToLower())
            {
                case "toronto":
                    return "powderblue";
                case "montreal":
                    return "lightgray";
                case "ottawa":
                    return "palegreen";
                case "calgary":
                    return "pink";

                default:
                    return "white";
            }
        } else
        {
            return "white";
        }
    }
}
