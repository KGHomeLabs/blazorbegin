<div class="row mb-3">
    <div class="col-2">
        <label class="col-form-label">@Label</label>
    </div>
    <div class="col-6 input-width">
        @* <InputText @bind-Value="server.Name" class="form-control " /> *@
        @WhateverControl
    </div>
    <div class="col">
        @* <ValidationMessage For="@(() => server.Name)" /> *@
        @MyValidationMessage
    </div>
</div>


@code {
    [Parameter]
    public string?  Label { get; set; }

    [Parameter]
    public RenderFragment? WhateverControl { get; set; }

    [Parameter]
    public RenderFragment? MyValidationMessage { get; set; }

}
