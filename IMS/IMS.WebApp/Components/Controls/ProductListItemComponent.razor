@using IMS.CoreBusiness
@using IMS.UseCases.Products.Interfaces
@using System.Threading.Tasks

@inject IDeleteProductUseCase DeleteUseCase
@if (Product is not null)
{
    <tr>
        <td>@Product.Name</td>
        <td>@Product.Quantity</td>
        <td>@Product.Price.ToString("c")</td>
        <td>
            <a href="/products/edit/@Product.Id" class="btn btn-light">
                Edit
            </a>
        </td>
        <td>
            <button 
                type="button" 
                class="btn btn-outline-danger"
                @onclick="async ()=> await HandleDelete(Product.Id)">
            Delete
            </button>
        </td>
    </tr>
}


@code {

    [Parameter]
    public Product? Product { get; set; }

    private async Task HandleDelete(int productId)
    {
        await DeleteUseCase.ExecuteAsync(productId);
        Product = null;
    }
}
