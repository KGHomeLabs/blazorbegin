@using IMS.CoreBusiness
@using IMS.UseCases.Inventories.Interfaces

@inject IViewInventoriesByNameUseCase ViewInventoryUC

<div class="input-group">
    <input class="form-control"
           placeholder="Type input stuff here"
           @bind-value="this.searchFilter"
           @bind-value:event="oninput" />
    <button type="button" 
            class="btn-success input-group-text"
            @onclick="HandleSearch">
        Search
    </button>
</div>

@if(inventories != null && inventories.Count > 0)
{
    <div class="search-result">
        <ul>
            @foreach(var inv in inventories)
            {
                <li @key="inv.InventoryId"
                    @onclick="()=>{HandleSelectInventory(inv);}"
                    >
                    
                    @inv.InventoryName
                </li>
            }
        </ul>
    </div>
}

@code {
    [Parameter]
    public EventCallback<Inventory> OnInventorySelected{ get; set; }

    private string _searchFilter = string.Empty;
    private string searchFilter { 
        get { return _searchFilter; } 
        set { 
            _searchFilter = value;
            HandleSearch();
        }
    }
    private List<Inventory> inventories = new List<Inventory>();

    private async Task HandleSearch()
    {
        await Task.Delay(1000);
        inventories = (await ViewInventoryUC.ExecuteAsync(this.searchFilter)).ToList();
        StateHasChanged();
    }

    private async Task HandleSelectInventory(Inventory inv)
    {
        await OnInventorySelected.InvokeAsync(inv);
        inventories.Clear();
    }
}
